# ==============================================================================
# UNO NIGHT - FULL-STACK AUTHENTICATION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network & Port Configuration
# Default backend port (default: 3001)
PORT=3001
NODE_ENV=development

# Server Public Domain URL
# Used for OAuth Redirect Callback URLs and CORS configuration
SERVER_URL=http://localhost:3001
CLIENT_URL=http://localhost:5173

# Internal Session Secret
# Used by express-session to encrypt temporary session handshakes during OAuth redirects
# Generate via: openssl rand -base64 32
SESSION_SECRET=a8f4c2e9d3b10567ef902143ab5678cd90ef1234567890abcdef1234567890ab

# JWT Signing Secret Key
# Used to sign and verify httpOnly auth cookies (7-day session token)
# Generate via: openssl rand -base64 32
JWT_SECRET=f9e8d7c6b5a4039281726354433221100f9e8d7c6b5a403928172635443322110

# ------------------------------------------------------------------------------
# OAUTH PROVIDER CREDENTIALS
# ------------------------------------------------------------------------------

# 1. Google OAuth 2.0 Credentials
# Get from: Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth 2.0 Client ID
# Authorized Redirect URI: http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# 2. Discord OAuth Credentials
# Get from: Discord Developer Portal (https://discord.com/developers/applications) -> App -> OAuth2
# Redirect URL: http://localhost:3001/api/auth/discord/callback
DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET
